# __tmpl_title -- an IRIS __tmpl_kind plugin, generated by `iris plugin new`.
[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "__tmpl_dist"
version = "0.1.0"
description = "__tmpl_title: __tmpl_summary."
readme = "README.md"
requires-python = ">=3.12"
license = { text = "Apache-2.0" }
# The stable tier this plugin is written against (docs/reference/stable-api.md): a 0.x
# minor release may remove what the one before it deprecated.
dependencies = ["__tmpl_{distribution}__tmpl_{harness_requirement}"__tmpl_{extra_dependencies}]

[project.optional-dependencies]
test = ["pytest>=8"]

# How IRIS finds the plugin once it is installed. The entry-point name is the plugin's
# name, the one a profile lists; the manifest ships in the package (package data).
[project.entry-points."__tmpl_entry_point_group"]
__tmpl_name = "__tmpl_entry_point"

[tool.setuptools.packages.find]
where = ["src"]

[tool.setuptools.package-data]
__tmpl_package = ["*.yaml"]

[tool.pytest.ini_options]
pythonpath = ["src"]
testpaths = ["tests"]

[tool.black]
line-length = 100
target-version = ["py312"]

[tool.ruff]
line-length = 100
src = ["src", "tests"]

[tool.ruff.lint]
select = ["E", "W", "F", "I", "B", "C4", "UP", "S"]
# E501: black owns line length (it leaves long strings alone); S101: pytest asserts.
ignore = ["E501", "S101"]
