# IRIS Environment Configuration
# Copy this file to .env and fill in the values

# ── Which plugins mount ────────────────────────────────────
#
# `default` is the harness plus its reference plugins and nothing else. The six
# personal-assistant domains (finance, filemanager, email, calendar, market) live in
# a second source root, src/iris_personal, and mount only under this profile
# (OSS plan M6, decisions 2 and 10). Unset, IRIS runs `email` when the email plugins
# are installed (default + Gmail + the email workflows), else `default`: there is no
# `iris files`, `iris finance` or `iris calendar` without this line.
IRIS_PROFILE="personal-assistant"

# ── Your time zone ─────────────────────────────────────────
# IANA name. The morning digest goes out at its `time` (config/digest.yaml, or
# Settings -> Digest) in this zone, and reminders and schedules read in it. Unset means
# UTC. docker-compose.yml also sets the container clock (TZ) from it.
# IRIS_TZ="America/Chicago"

# ── LLM Providers ──────────────────────────────────────────
#
# Phase 2 governance migration (see docs/usage-guides/vault-operations.md):
# the values below accept either a raw secret OR a vault://<handle>
# reference. Recommended setup:
#   1. paste the raw value here once
#   2. `iris vault import-env`         (moves it into the encrypted vault)
#   3. set the value below to `vault://<handle>` shown by `iris vault list`
#   4. delete the original from any shared `.env` / secret-store snapshot
# Raw values continue to work — the migration is opt-in per variable.

# GitHub Models API (primary) — uses your Copilot subscription
GITHUB_TOKEN="ghp_..."                  # or: vault://github-token

# OpenRouter (fallback) — access to Claude, GPT, Llama, etc.
OPENROUTER_API_KEY="sk-or-..."          # or: vault://openrouter-api-key

# Anthropic (optional) — direct Claude access
ANTHROPIC_API_KEY="sk-ant-..."          # or: vault://anthropic-api-key

# Ollama (optional) — local LLM runtime
OLLAMA_BASE_URL="http://localhost:11434"

# LM Studio (optional) — second local runtime (best for HuggingFace / MLX models on Apple Silicon).
# Start the LM Studio Developer-tab server, then set the model id in config/llm_tiers.yaml.
# LM_STUDIO_BASE_URL defaults to http://localhost:1234; LM_STUDIO_API_KEY value is ignored by
# LM Studio itself but the OpenAI SDK needs a non-empty string.
LM_STUDIO_BASE_URL="http://localhost:1234"
LM_STUDIO_API_KEY="lm-studio"

# ── Ollama daemon tuning ──────────────────────────────────
# These are read by the `ollama serve` process (NOT by IRIS).
# Set them in your shell profile / launchd plist before starting Ollama.
# Recommended for 36 GB Apple-silicon Macs running multiple tiers:
#   OLLAMA_MAX_LOADED_MODELS=1   # never two models resident at once
#   OLLAMA_NUM_PARALLEL=1        # one in-flight request per model (KV cache scales w/ this)
#   OLLAMA_KEEP_ALIVE=60s        # global default; per-tier overrides win once num_ctx lands
#   OLLAMA_FLASH_ATTENTION=1     # MEASURED A REGRESSION on Apple Silicon (exp-004
#   OLLAMA_KV_CACHE_TYPE=q8_0    # spike 3: -6% decode for memory IRIS can't use at
#                                # 1-8k contexts). Leave UNSET unless memory-bound.
#   OLLAMA_HOST=127.0.0.1:11434

# ── Embeddings / HuggingFace Hub ──────────────────────────
# Email triage uses sentence-transformers (all-MiniLM-L6-v2). On load,
# huggingface_hub pings the Hub and, without a token, warns about anonymous
# rate limits ("You are sending unauthenticated requests to the HF Hub").
# Once the model is cached locally (after the first run), set HF_HUB_OFFLINE=1
# to skip all Hub calls — silences the warning and speeds up startup.
# HF_HUB_OFFLINE=1
# HF_TOKEN=hf_...                    # optional: higher Hub rate limits / faster downloads

# ── IRIS resource governor (opt-in) ───────────────────────
# When set to "1", the ResourceGovernor downshifts large local tiers to tier1
# under host pressure (low free RAM or macOS thermal throttling). Off by default
# so the governor only logs what it *would* do — flip on after observing logs.
# IRIS_ADAPTIVE_TIERS=1
#
# Disable the OllamaArbiter pre-emptive eviction (mostly for tests).
# IRIS_DISABLE_ARBITER=1

# ── Observability (optional) ──────────────────────────────
# OpenTelemetry traces, exported over OTLP to a backend YOU run (Phoenix, Jaeger,
# Grafana Tempo, Honeycomb, an OTel Collector...). IRIS bundles no trace UI. Unset =
# nothing is exported. The standard OTEL_* variables are read as the SDK reads them;
# see docs/guides/tracing.md for one example per backend.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4318"     # /v1/traces is appended
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://127.0.0.1:4318/v1/traces"  # full URL, wins
# OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"              # or "grpc" (port 4317)
# OTEL_EXPORTER_OTLP_HEADERS="x-api-key=..."               # backend auth, if any
# OTEL_SERVICE_NAME="iris"
# Which libraries get client spans while exporting (both default on):
# IRIS_OTEL_LANGCHAIN_ENABLED=1
# IRIS_OTEL_HTTPX_ENABLED=1
# IRIS_CHANNEL_GATEWAY_TRACING_ENABLED=1

# Where scripts/purge_traces.sh archives trace/audit/run logs before deleting
# them. Defaults to ~/.iris/archive (a timestamped subfolder per purge).
# IRIS_TRACE_ARCHIVE_DIR="~/.iris/archive"

# ── Coding Agent ───────────────────────────────────────────

# GitHub PAT for PR creation (needs repo scope)
GITHUB_PAT_CODING_AGENT="ghp_..."       # or: vault://github-pat-coding-agent

# Target repository (owner/repo)
GITHUB_REPO="evarness-ai/iris-harness"

# ── Governor (optional) ───────────────────────────────────

# The live-git pilot uses the embedded IRIS governor by default.
# Set this only when you want to force the HTTP wrapper instead.
IRIS_GOVERNOR_BASE_URL="http://localhost:8080"

# Unified governance layer — SECURE BY DEFAULT (exp-007 GAP-13): the embedded
# classifier / egress gate / command-fs-network jails are ON unless you explicitly
# opt out. Set to a falsy value (0/false/no/off) to DISABLE (logged at WARNING).
# IRIS_GOVERNANCE_ENABLED=0   # <-- uncomment ONLY to turn the safety layer OFF
# IRIS_GOVERNANCE_TRUSTED_CLOUD_FOR="personal"
# IRIS_GOVERNANCE_ALLOWED_TOOLS="web_search,memory_search,wiki_search"
# IRIS_GOVERNANCE_BLOCKED_TOOLS="propose_skill_from_sandbox"
# IRIS_GOVERNANCE_CONFIRM_ONCE_TOOLS=""                  # ADR-0110: which tools ask first is their manifest's `confirm:`; this CSV only ADDS names
# IRIS_GOVERNANCE_COMMAND_SANDBOX=1                 # Phase 4: persona command allow/deny + metachar guard
# IRIS_GOVERNANCE_FS_JAIL=1                         # Phase 4: symlink-resolved write jail for coding personas
# IRIS_GOVERNANCE_NETWORK_EGRESS=1                  # Phase 4: per-persona outbound HTTP domain allowlist (default-deny)
# IRIS_GOVERNANCE_MCP_ALLOWLIST=1                   # Phase 4: per-persona MCP server tool allowlist
# IRIS_MCP_SERVERS_CONFIG_PATH=config/coding-agent/mcp-servers.yaml
# IRIS_GOVERNANCE_REDACTION_ENABLED=1               # vault-handle + regex-pack outbound scrub
# IRIS_GOVERNANCE_VAULT_DB_PATH=~/.config/iris/vault.db
# IRIS_GOVERNANCE_DISPLAY_MASK=0                    # DEFAULT ON: mask email addresses on the way to a
#                                                   # screen. Display only - the audit ledger and session
#                                                   # log keep the original text.
#
# HITL approval queue — DEFAULT ON. A signal that returns require_approval enqueues a
# request and pauses the run; `iris approvals list|approve|reject` answers it.
# IRIS_GOVERNANCE_APPROVALS_ENABLED=0               # <-- disables the queue; halts stop being answerable
#
# Evaluator signals that need an embedder — OPT-IN, and one flag turns on two signals.
# loop_detect and goal_drift share the ONNX MiniLM embedder, so this flag gates both.
# IRIS_GOVERNANCE_LOOP_DETECT_ENABLED=1             # also enables goal_drift
# IRIS_GOVERNANCE_GOAL_DRIFT_MAX_DISTANCE=0.90      # cosine distance above which a thought asks for
#                                                   # approval. Unset = 0.90. Measured, not calibrated:
#                                                   # on-task thoughts reach 0.86 on a short question and
#                                                   # real drift starts near 0.88. Out-of-range values are
#                                                   # ignored with a warning.
# IRIS_GOVERNANCE_DRIFT_EXEMPTIONS_DB_PATH=~/.local/share/iris/drift_exemptions.db
#                                                   # thought shapes your approvals taught goal_drift to
#                                                   # allow; `iris approvals exemptions` reads it.
#
# External-content floor — ON by default. A tool, capability or MCP result declared
# `content: external` (text a third party wrote) reaches the model inside an
# <external_content ... trust="untrusted"> envelope, and a small deterministic pattern list
# (instruction overrides, chat-template / tool-call syntax, exfiltration instructions, hidden
# characters) is redacted with a ledger row. No model, no weights, no network.
# Valid values: true, false, 1, 0, yes, no, on, off. Default: true. Off logs a warning.
# IRIS_GOVERNANCE_EXTERNAL_CONTENT_FLOOR=true
#
# Indirect-injection guard over tool / RAG results (Phase 6 G2) — OPT-IN, shadow-first.
# A classifier on top of the floor above; needs the `ml` extra and a gated Hugging Face download.
# IRIS_GOVERNANCE_PROMPT_GUARD=1
#
# Input safety screen — OPT-IN, follows threat-detection.yaml `mode` (shadow-first). Screens
# every user turn for hazards (self-harm, violence, ...) with the output guard's Llama Guard
# model before any handler or model answers it. A slow or missing model lets the turn through.
# IRIS_GOVERNANCE_INPUT_SAFETY=1
#
# Owner-PII guards (ADR-0125) — off by default. `shadow` audits what each guard would do
# with the owner's name, email, phone, address and handles and changes nothing; read it
# back with `iris governance pii-shadow`. Any other value (enforce arrives in PR 5) runs
# shadow with a startup warning.
# IRIS_GOVERNANCE_OWNER_PII=off
#
# Side-effect ledger. Values: on = 1/true/yes/on, off = 0/false/no/off (any case).
# Default: on (unset is the same as 1). On, a destructive tool's or a pinned write's row is
# written before the call runs, so a crash leaves a record a resumed run can check; plain
# writes and reads are not recorded. Off: destructive tools and pinned writes are denied,
# since none runs without a durable record. Any other value warns and applies the default.
# IRIS_GOVERNANCE_SIDE_EFFECT_LEDGER=1
# Side-effect ledger scope. Values: on = 1/true/yes/on, off = 0/false/no/off (any case).
# Default: off. On also records every other non-read call's effect (commits, pushes, file
# writes, sends), so a resumed run can verify it with a probe instead of re-running it. No
# effect (and a warning) while the ledger is off. (LEDGER=1 used to mean this; it no longer
# does.) Any other value warns and applies the default.
# IRIS_GOVERNANCE_SIDE_EFFECT_LEDGER_ALL=0
# IRIS_GOVERNANCE_SIDE_EFFECT_LEDGER_DB_PATH=~/.local/share/iris/side_effects.db
#
# Cost limiter — OPT-IN, and two switches. ENABLED starts the ledger; nothing else
# writes it, so with it off every spend figure is a truthful 0.00 meaning "nobody is
# counting". ENFORCE decides whether passing the cap refuses the call, and defaults to
# 1 — set it to 0 to record spend without stopping anything. The cap is measured
# against an ESTIMATE (tokens priced by kernel/governance/cost/pricing.py, whose cloud
# default is GPT-4o-class), not against a provider's bill.
# IRIS_GOVERNANCE_COST_LIMITER_ENABLED=1
# IRIS_GOVERNANCE_COST_ENFORCE=1
# IRIS_GOVERNANCE_DAILY_COST_CAP_USD=5.00
# IRIS_GOVERNANCE_COST_LEDGER_DB_PATH=~/.local/share/iris/cost-ledger.db
#
# Governance audit ledger (the chat/kernel `audit_log` the inspect CLI reads).
# IRIS_GOVERNANCE_AUDIT_DB_PATH=~/.local/share/iris/audit.db
# Evaluator sidecar (src/iris_harness/server/evaluator, port 8090) — OPT-IN. Default "local" runs the
# evaluator in-process; set "remote" to route through the sidecar (`iris evaluator start`).
# IRIS_GOVERNANCE_EVALUATOR_MODE=remote
# IRIS_GOVERNANCE_EVALUATOR_URL=http://127.0.0.1:8090
# IRIS_GOVERNANCE_EVALUATOR_TIMEOUT_S=5.0
#
# Async LLM judge over the finished trace (§9.2) — OPT-IN, and OFF by default.
# It scores hallucination, goal alignment, tool misuse and danger; a halt
# recommendation alerts every channel (it does not stop anything), the rest go to
# the audit log. It never touches the run in flight.
# IRIS_GOVERNANCE_JUDGE_ENABLED=1                  # post-run safety review of every run that used tools
# IRIS_GOVERNANCE_JUDGE_TIER=run                    # run = the run's own model route; or any llm_tiers.yaml
#                                                   # tier (e.g. tier2, private, tier3), local or cloud
# IRIS_GOVERNANCE_JUDGE_TIMEOUT_S=30.0
# Superseded by IRIS_GOVERNANCE_JUDGE_TIER (only the unused judge_from_env reads them):
# IRIS_GOVERNANCE_JUDGE_MODEL_TIER=tier_2
# IRIS_GOVERNANCE_JUDGE_CLOUD_OPT_IN=1
#
# Response-curator semantic leak-judge (exp-007) — DEFAULT ON. An LLM second-opinion that
# clears benign self-descriptions the dump-phrase guard flags, so the assistant won't refuse
# to describe itself. Only fires on flagged responses; fails closed (halt) if unavailable.
# IRIS_CURATOR_LEAK_JUDGE=0                          # <-- set to disable the leak-judge
#
# Vault master key (Phase 2). Either set this OR let the OS keyring seed
# one automatically on first vault open. Generate a fresh key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IRIS_VAULT_MASTER_KEY=""

# Backward-compatible alias for older scripts and adapters.
# GOVERNOR_BASE_URL="http://localhost:8080"

# ── Telegram Gateway ──────────────────────────────────────

# Bot token from @BotFather — enables inbound message polling + outbound notifications.
TELEGRAM_BOT_TOKEN="123456:ABC-..."

# Your personal Telegram chat ID — restricts the bot to only respond to you.
# Run @userinfobot or send /start to your bot and check the logs to find it.
TELEGRAM_CHAT_ID="123456789"

# Optional: more than one allowed chat (comma-separated). Defaults to TELEGRAM_CHAT_ID.
# TELEGRAM_ALLOWED_CHAT_IDS="123456789,-1001234567890"

# Optional: allowed Telegram USER ids (comma-separated, the sender's from.id). The chat
# allowlist admits a chat, which in a group means every member; set this to also require
# that a message or a button tap comes from one of these people. Unset = no user check.
# TELEGRAM_ALLOWED_USER_IDS="123456789"

# ── Authentication (REQUIRED) ─────────────────────────────

# Shared bearer secret for every backend service route (iris_api :8003,
# governor :8080, evaluator :8090) and the channel-gateway WebSocket.
# All bundled clients (REPL/CLI, web UI proxy, gateway, coding agent) read
# this same variable and attach `Authorization: Bearer <secret>` themselves.
# Without it the services fail closed (503 on every non-health route).
IRIS_AUTH_SECRET="change-me-to-a-long-random-string"
# IRIS_AUTH_CODE_HASH="$2b$12$..."

# ── Research engine (web search + crawl + rerank) ─────────
# One `research` tool over a pluggable provider chain. Works out of the box with the
# keyless DuckDuckGo floor; everything below is optional. See
# docs/architecture/research-engine.md. Provider priority:
#   SearXNG → Tavily → Exa → Brave → DuckDuckGo (first available with hits wins).

# PRIMARY (recommended): self-hosted SearXNG. Start it with
#   docker compose -f deploy/searxng/docker-compose.yml up -d
# then point IRIS at it (and restart the IRIS API):
# IRIS_SEARXNG_URL="http://localhost:8888"

# Optional keyed providers — set a key to enable that backend.
# TAVILY_API_KEY=""        # LLM-optimized search (https://tavily.com)
# EXA_API_KEY=""           # neural search (https://exa.ai)
# BRAVE_API_KEY=""         # Brave Search API (independent index)

# Result cache: sqlite (default) | redis | off. Redis needs `pip install redis`;
# falls back to the SQLite cache if redis is missing/unreachable.
# IRIS_RESEARCH_CACHE="sqlite"
# IRIS_REDIS_URL="redis://localhost:6379/0"

# Reranker: none (default) | bge. BGE uses a sentence-transformers cross-encoder
# (model downloads on first use); a missing model is a silent no-op.
# IRIS_RESEARCH_RERANKER="none"
# IRIS_RESEARCH_RERANKER_MODEL="BAAI/bge-reranker-base"

# Crawler: trafilatura (default) | crawl4ai. Crawl4AI handles JS-heavy pages but needs
# `pip install crawl4ai` (+ `playwright install`); falls back to Trafilatura otherwise.
# IRIS_RESEARCH_CRAWLER="trafilatura"

# Cloud search synthesis (opt-in, EGRESS): run the "search" ReAct loop on a cloud model
# that follows ReAct + synthesizes web results far better than the local 7B. Only
# "copilot" is wired today (uses your GitHub Copilot subscription; needs
# IRIS_ENABLE_COPILOT_BACKEND=1 + a Copilot OAuth token). The search query + crawled page
# CONTENT leave the box to Copilot — it's a governed, egress-evaluated call. Unset = local.
# IRIS_SEARCH_SYNTHESIS_PROVIDER="copilot"
# Default gpt-5-mini (cheaper Copilot tier). Reasoning model → slower but low cost;
# set claude-sonnet-4.5 for faster/stronger answers at a premium multiplier.
# IRIS_SEARCH_SYNTHESIS_MODEL="gpt-5-mini"

# ── Digital twin (learning layers) ────────────────────────
# Inferred layers are propose-only/HITL and OFF by default. See
# docs/architecture/digital-twin.md. Surfaces: `iris behaviors|signals|intentions`,
# the /learning/* API, and the web Digital Twin screen.

# Layer 1 — mine recurring habits from durable turns (heartbeat: behavior_mining_tick).
# IRIS_BEHAVIOR_MINER=0

# Layer 3 — roll tasks/routines/habits/signals up into longitudinal goals
# (heartbeat: intention_rollup_tick).
# IRIS_INTENTION_ROLLUP=0

# Allow approve/reject/dismiss + other control writes from the web UI when the caller
# authenticates with IRIS_AUTH_SECRET (default read-only). A device paired at `control`
# scope may write without this; one paired at `read` may not, whatever it is set to
# (ADR-0117 amendment).
# IRIS_WEBUI_ALLOW_WRITES=0

# Serve the web console's production build from the IRIS API (no Vite needed).
# Point it at a directory produced by `cd webui && npm run build`. The default is the
# server image's location; where no build exists the API serves no UI. The shell and
# /assets load without a token, every data call still needs one. Read at startup.
# IRIS_WEBUI_DIST=/app/webui/dist

# Name this deployment in the web console. /capabilities returns it as
# `deployment_label` and the console shows a "Remote harness" badge with it, so a
# server's figures are never read as the laptop's. The console in the server image is
# built once for every deployment, which is why the name is a runtime setting. Leave it
# unset on the ordinary local harness: no label, no badge. Not a secret, but it is only
# returned to an authenticated caller.
# IRIS_DEPLOYMENT_LABEL=

# The web console's absolute address, for links sent outside it: the morning digest's
# Telegram buttons ("Full digest", "Digest settings") open <this>/digest/<id> and
# <this>/settings#digest. Unset: the digest goes out without buttons. Behind
# `tailscale serve` it is the tailnet HTTPS name.
# IRIS_PUBLIC_URL=https://<your-host>.ts.net
