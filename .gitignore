# Data files (contain user data)
# Everything under data/ is runtime state written by the services (uploads, stores,
# caches). Ignore it all by default so a new store (data/rag_uploads/ once held a demo
# upload, untracked) cannot slip into a commit; only the folder's guide is tracked.
# The specific rules below predate this and stay as documentation of what lives here.
data/*
!data/CLAUDE.md
data/*.db
data/brief_prefs.json
# SQLite WAL/SHM sidecars (WAL journal mode) — local runtime cache, never commit
*.db-wal
*.db-shm
*.db-journal
# Research engine result cache — local, regenerable
data/research_cache.db*
# local DB backups (e.g. memory.db.bak-YYYYMMDD) — same user data, never commit
data/*.db.bak*
# memris fact migration (ADR-0115): its automatic backup of memory.db and its reports
# (they list the user's facts) — same user data, never commit
data/backups/
data/memris-migration/
data/vault/
data/wiki/
data/chroma/
# RAG/document Chroma store — indexed user content, never commit
data/chroma_docs/
data/chroma_watermark
# Semantic email index (ADR-0071) — vectors over the user's mail, never commit
data/email_semantic/
# downloaded statement PDFs — sensitive financial data, never commit
data/finance/
# generated calendar .ics artifacts — event details, never commit
data/calendar/
data/calendar_ics/
*.ics
# FileManager allowed-roots config + trash (paths to the user's private files)
data/filemanager.json
data/filemanager_trash/
# FileManager custody store — files IRIS holds on behalf of agents, never commit
data/filemanager/

# Local-only compose override (audit host) — not part of the committed stack
docker-compose.audithost.yml

# Logs
*.log
logs/

# Node.js (web frontend)
web/node_modules/
web/dist/
web/coverage/
web/.benchmarks/
# The web console build the release wheel carries (OSS plan R6): scripts/bundle_webui.py
# copies webui/dist here at release time and pyproject's `include` ships it.
src/iris_harness/server/iris_api/webui_dist/


# mypy
.mypy_cache/

# ruff
.ruff_cache/

# Pre-commit
.pre-commit-cache/

# Phoenix observability data
.phoenix/

# graphify knowledge-graph output (a local tool; the repo keeps none of it).
graphify-out/
*.graphify_python
.graphify_*

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Phase 1 spike artifacts (real email data, never commit)
data/spike/

# Per-agent settings overrides (local, user-edited via UI/CLI) — ADR-0074
config/agent_settings.local.yaml

# Crystallizer skill proposals (ADR-0068): machine-generated, quarantined, and
# human-promoted — runtime learning artifacts, regenerated from signals. Never commit.
config/skills/auto/

.phase2-baselines/

# memris PR 2: the dry-run report and triage file hold personal fact values
data/memris-migration/

# Playwright (webui viewport smoke) — reports and per-run artifacts.
webui/playwright-report/
webui/test-results/
